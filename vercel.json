{
  "functions": {
    "api/sports.js": {
      "maxDuration": 30
    },
    "api/pmgames.js": {
      "maxDuration": 30
    },
    "api/ai.js": {
      "maxDuration": 60
    },
    "api/book.js": {
      "maxDuration": 30
    },
    "api/xauth.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/(js|css)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
